# GEMINI_API_KEY: Digunakan di sisi server apabila diperlukan.
GEMINI_API_KEY=""

# APP_URL: URL aplikasi saat dijalankan di Cloud Run / lingkungan produksi.
APP_URL=""

# VITE_API_URL: URL Express server di Render (diisi setelah deploy ke Render).
# Contoh: VITE_API_URL=https://newsapp-bloger-api.onrender.com
# Kosongkan jika frontend dan server jalan di host yang sama (mode dev / Render all-in-one).
VITE_API_URL=""

# Konfigurasi Blogger API v3.0 (Disimpan aman di sisi server, tidak dikirim ke browser)
BLOGGER_BLOG_ID="4682143712664244285"
BLOGGER_API_KEY=""

# Konfigurasi Pengelola (Admin) Portal Berita
ADMIN_USERNAME="admin"
